+package painter
+
+import (
+	"image"
+	"image/color"
+	"strings"
+	"unicode/utf8"
+
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/canvas"
+	"fyne.io/fyne/v2/theme"
+	"github.com/clipperhouse/uax29/v2/graphemes"
+)
+
+func systemFontName(source fyne.Resource, style fyne.TextStyle) string {
+	if source == nil {
+		source = theme.Font(style)
+	}
+	if system, ok := source.(fyne.SystemFontResource); ok {
+		return system.SystemFontName()
+	}
+	return ""
+}
+
+func singleLineText(text string) string {
+	text = strings.ReplaceAll(text, "\r", "")
+	text = strings.ReplaceAll(text, "\n", string(rune(replacementChar)))
+	return strings.ToValidUTF8(text, string(rune(replacementChar)))
+}
+
+// SystemTextTruncate fits an ellipsized label with the same engine that paints
+// it. The returned prefix length is in runes, on a grapheme boundary, so flags,
+// combining marks and ZWJ emoji are kept together. Portable fonts return ok=false.
+func SystemTextTruncate(s string, text *canvas.Text, limit float32, suffix string) (count int, full, ok bool) {
+	source := text.FontSource
+	if source == nil {
+		source = theme.CurrentForWidget(text).Font(text.TextStyle)
+	}
+	name := systemFontName(source, text.TextStyle)
+	if name == "" {
+		return 0, false, false
+	}
+	measure := func(value string) (fyne.Size, bool) {
+		size, _, ok := measureSystemText(singleLineText(value), name, text.TextSize, text.TextStyle)
+		return size, ok
+	}
+	size, ok := measure(s)
+	if !ok {
+		return 0, false, false
+	}
+	if size.Width <= limit {
+		return utf8.RuneCountInString(s), true, true
+	}
+	ends := []int{0}
+	clusters := graphemes.FromString(s)
+	for clusters.Next() {
+		ends = append(ends, clusters.End())
+	}
+	low, high := 0, len(ends)-1
+	for low < high {
+		mid := (low + high + 1) / 2
+		size, ok := measure(s[:ends[mid]] + suffix)
+		if !ok {
+			return 0, false, false
+		}
+		if size.Width <= limit {
+			low = mid
+		} else {
+			high = mid - 1
+		}
+	}
+	return utf8.RuneCountInString(s[:ends[low]]), false, true
+}
+
+// DrawCanvasText uses the same platform text engine as measureText. Keeping
+// this dispatch above font parsing avoids loading Go font tables in a native
+// system-font UI. Explicit/custom fonts retain Fyne's portable renderer.
+func DrawCanvasText(dst *image.RGBA, text *canvas.Text, scale float32, offset int) {
+	ink := text.Color
+	if ink == nil {
+		ink = theme.Color(theme.ColorNameForeground)
+	}
+	source := text.FontSource
+	if source == nil {
+		source = theme.CurrentForWidget(text).Font(text.TextStyle)
+	}
+	if name := systemFontName(source, text.TextStyle); name != "" {
+		if drawSystemText(dst, singleLineText(text.Text), name, text.TextSize, scale, text.TextStyle, color.NRGBAModel.Convert(ink).(color.NRGBA), offset) {
+			return
+		}
+	}
+	face := CachedFontFace(text.TextStyle, text.FontSource, text)
+	DrawStringOffset(dst, text.Text, ink, face.Fonts, text.TextSize, scale, text.TextStyle, offset)
+}
