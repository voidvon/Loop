diff --git a/internal/painter/text_coretext_darwin.m b/internal/painter/text_coretext_darwin.m
new file mode 100644
index 0000000..c03a7bd
--- /dev/null
+++ b/internal/painter/text_coretext_darwin.m
@@ -0,0 +1,147 @@
+//go:build darwin && cgo && !ios
+
+#import <Foundation/Foundation.h>
+#import <CoreText/CoreText.h>
+#import <CoreGraphics/CoreGraphics.h>
+#include <math.h>
+#include <pthread.h>
+#include "text_coretext_darwin.h"
+
+// Only font objects are cached, never lines or application strings. Return
+// a retained font so eviction cannot invalidate another thread's active call.
+static pthread_mutex_t loopFontMutex = PTHREAD_MUTEX_INITIALIZER;
+static NSMutableDictionary *loopFonts;
+static NSMutableArray *loopFontOrder;
+static CTFontRef loopTextFont(const char *name, double size, int italic) {
+    NSString *fontName = [NSString stringWithUTF8String:name];
+    if (!fontName) return NULL;
+    NSString *key = [NSString stringWithFormat:@"%@:%a:%d", fontName, size, italic];
+    pthread_mutex_lock(&loopFontMutex);
+    if (!loopFonts) {
+        loopFonts = [[NSMutableDictionary alloc] init];
+        loopFontOrder = [[NSMutableArray alloc] init];
+    }
+    CTFontRef font = (CTFontRef)[loopFonts objectForKey:key];
+    if (font) {
+        CFRetain(font);
+        [loopFontOrder removeObject:key];
+        [loopFontOrder addObject:key];
+    } else {
+        font = CTFontCreateWithName((CFStringRef)fontName, size, NULL);
+        if (font && italic) {
+            CTFontRef styled = CTFontCreateCopyWithSymbolicTraits(font, size, NULL,
+                                        kCTFontItalicTrait, kCTFontItalicTrait);
+            if (!styled) {
+                CGAffineTransform slant = CGAffineTransformMake(1, 0, tan(12 * M_PI / 180), 1, 0, 0);
+                styled = CTFontCreateCopyWithAttributes(font, size, &slant, NULL);
+            }
+            if (styled) { CFRelease(font); font = styled; }
+        }
+        if (font) {
+            if (loopFontOrder.count >= 48) {
+                [loopFonts removeObjectForKey:[loopFontOrder objectAtIndex:0]];
+                [loopFontOrder removeObjectAtIndex:0];
+            }
+            [loopFonts setObject:(id)font forKey:key];
+            [loopFontOrder addObject:key];
+        }
+    }
+    pthread_mutex_unlock(&loopFontMutex);
+    return font;
+}
+
+// One line layout serves both measuring and painting. Fyne handles wrapping
+// above this layer. Tabs follow Fyne's fixed stops instead of CoreText defaults.
+static LoopTextMetrics loopTextProcess(const char *text, size_t length,
+        const char *name, double size, int italic, int mono, int tabWidth,
+        CGContextRef context, double scale, int offset) {
+    LoopTextMetrics metrics = {0};
+    CTFontRef font = loopTextFont(name, size, italic);
+    if (!font) return metrics;
+    NSString *string = [[[NSString alloc] initWithBytes:text length:length
+                                            encoding:NSUTF8StringEncoding] autorelease];
+    if (!string) { CFRelease(font); return metrics; }
+    NSDictionary *attributes = @{
+        (id)kCTFontAttributeName: (id)font,
+        (id)kCTForegroundColorFromContextAttributeName: @YES,
+        // The JSON editor places its caret on a fixed monospace grid.
+        (id)kCTLigatureAttributeName: @(mono ? 0 : 1)
+    };
+    NSArray *parts = [string componentsSeparatedByString:@"\t"];
+    NSMutableArray *lines = [NSMutableArray arrayWithCapacity:parts.count];
+    double ascent = CTFontGetAscent(font), descent = CTFontGetDescent(font);
+    double leading = fmax(0, CTFontGetLeading(font));
+    for (NSString *part in parts) {
+        NSAttributedString *attributed = [[[NSAttributedString alloc]
+                    initWithString:part attributes:attributes] autorelease];
+        CTLineRef line = CTLineCreateWithAttributedString((CFAttributedStringRef)attributed);
+        if (!line) { CFRelease(font); return metrics; }
+        CGFloat a = 0, d = 0, l = 0;
+        CTLineGetTypographicBounds(line, &a, &d, &l);
+        ascent = fmax(ascent, a); descent = fmax(descent, d); leading = fmax(leading, l);
+        [lines addObject:(id)line];
+        CFRelease(line);
+    }
+    if (tabWidth <= 0) tabWidth = 4;
+    double tab = 10 * tabWidth;
+    if (mono) {
+        NSAttributedString *space = [[[NSAttributedString alloc]
+                    initWithString:@" " attributes:attributes] autorelease];
+        CTLineRef spaceLine = CTLineCreateWithAttributedString((CFAttributedStringRef)space);
+        tab = CTLineGetTypographicBounds(spaceLine, NULL, NULL, NULL) * tabWidth;
+        CFRelease(spaceLine);
+    }
+    if (tab <= 0) tab = 10;
+    metrics.baseline = ascent;
+    metrics.height = ceil(ascent + descent + leading);
+    double x = 0;
+    if (context) {
+        // CoreGraphics uses a bottom-left baseline, while Fyne positions text
+        // from the top of the bitmap. Keep glyphs upright and convert the origin.
+        CGContextScaleCTM(context, scale, scale);
+        CGContextSetTextMatrix(context, CGAffineTransformIdentity);
+    }
+    NSUInteger index = 0;
+    for (id entry in lines) {
+        CTLineRef line = (CTLineRef)entry;
+        if (context) {
+            double baseline = (CGBitmapContextGetHeight(context) - ceil(ascent*scale)) / scale;
+            CGContextSetTextPosition(context, x - offset/scale, baseline);
+            CTLineDraw(line, context);
+        }
+        x += CTLineGetTypographicBounds(line, NULL, NULL, NULL);
+        if (++index < lines.count) x = (floor(x/tab) + 1)*tab;
+    }
+    metrics.width = x;
+    metrics.ok = 1;
+    CFRelease(font);
+    return metrics;
+}
+
+LoopTextMetrics loopTextMeasure(const char *text, size_t length, const char *name,
+                               double size, int italic, int mono, int tabWidth) {
+    @autoreleasepool {
+        return loopTextProcess(text, length, name, size, italic, mono, tabWidth, NULL, 1, 0);
+    }
+}
+
+int loopTextDraw(uint8_t *pixels, int width, int height, int stride,
+        const char *text, size_t length, const char *name, double size,
+        int italic, int mono, int tabWidth, double scale, int offset,
+        double red, double green, double blue, double alpha) {
+    @autoreleasepool {
+        CGColorSpaceRef space = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+        CGContextRef context = CGBitmapContextCreate(pixels, width, height, 8,
+                    stride, space, kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+        CGColorSpaceRelease(space);
+        if (!context) return 0;
+        CGContextSetAlpha(context, alpha);
+        CGContextSetRGBFillColor(context, red, green, blue, 1);
+        CGContextSetShouldAntialias(context, true);
+        CGContextSetShouldSmoothFonts(context, false);
+        LoopTextMetrics metrics = loopTextProcess(text, length, name, size, italic,
+                                            mono, tabWidth, context, scale, offset);
+        CGContextRelease(context);
+        return metrics.ok;
+    }
+}
diff --git a/internal/painter/text_coretext_darwin_test.go b/internal/painter/text_coretext_darwin_test.go
