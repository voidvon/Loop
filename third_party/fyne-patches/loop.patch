index 0000000..3d54003
--- /dev/null
+++ b/internal/painter/text_coretext_darwin_test.go
@@ -0,0 +1,180 @@
+//go:build darwin && cgo && !ios
+
+package painter
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"math"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/canvas"
+)
+
+type nativeOnlyFont string
+
+func (f nativeOnlyFont) Name() string           { return string(f) + ".ttf" }
+func (f nativeOnlyFont) SystemFontName() string { return string(f) }
+func (f nativeOnlyFont) Content() []byte        { panic("native text must not parse Go font tables") }
+
+func TestCoreTextBypassesFontParsingAndRendersMixedScripts(t *testing.T) {
+	measureFontCache.Lock()
+	before := len(measureFontCache.fonts)
+	measureFontCache.Unlock()
+	for _, name := range []string{"PingFangSC-Regular", "PingFangSC-Semibold", "Menlo-Regular", "Menlo-Bold", "AppleSymbols"} {
+		for _, text := range []string{"Loop Agj", "首页 节点 策略 配置", "US 🇺🇸 🚀 中文", "e\u0301 ﬁ → ⌘", ""} {
+			style := fyne.TextStyle{Monospace: name == "Menlo-Regular", Italic: name == "PingFangSC-Semibold"}
+			size, baseline := measureText(text, 16, style, nativeOnlyFont(name))
+			if size.Height <= 0 || baseline <= 0 || baseline > size.Height || (text != "" && size.Width <= 0) {
+				t.Fatalf("%s %q: invalid metrics %v, baseline %v", name, text, size, baseline)
+			}
+			img := image.NewRGBA(image.Rect(0, 0, int(math.Ceil(float64(size.Width*2)))+8, int(size.Height*2)+8))
+			obj := &canvas.Text{Text: text, TextSize: 16, TextStyle: style, FontSource: nativeOnlyFont(name), Color: color.NRGBA{R: 200, G: 40, B: 70, A: 128}}
+			DrawCanvasText(img, obj, 2, 0)
+			pixels := 0
+			for i := 0; i < len(img.Pix); i += 4 {
+				a := img.Pix[i+3]
+				if a > 128 {
+					t.Fatal("native text or color emoji ignored text opacity")
+				}
+				if a > 0 {
+					pixels++
+				}
+				if img.Pix[i] > a || img.Pix[i+1] > a || img.Pix[i+2] > a {
+					t.Fatal("native bitmap is not premultiplied RGBA")
+				}
+			}
+			if (pixels > 0) != (text != "") {
+				t.Fatalf("%s %q: painted %d pixels", name, text, pixels)
+			}
+		}
+	}
+	measureFontCache.Lock()
+	defer measureFontCache.Unlock()
+	if len(measureFontCache.fonts) != before {
+		t.Fatal("native text populated the Go font table cache")
+	}
+}
+
+func TestCoreTextClippedDrawingMatchesFullTexture(t *testing.T) {
+	for _, scale := range []float32{1, 1.5, 2} {
+		text := "Loop 中文 🇺🇸 🚀\t长配置 abcdefghijklmnopqrstuvwxyz"
+		style := fyne.TextStyle{Monospace: true, TabWidth: 4}
+		font := "Menlo-Regular"
+		size, _, _ := measureSystemText(text, font, 16, style)
+		full := image.NewRGBA(image.Rect(0, 0, int(math.Ceil(float64(size.Width*scale)))+8, int(math.Ceil(float64(size.Height*scale)))+8))
+		ink := color.NRGBA{R: 21, G: 110, B: 220, A: 190}
+		if !drawSystemText(full, text, font, 16, scale, style, ink, 0) {
+			t.Fatal("full texture failed")
+		}
+		for _, offset := range []int{17, 67, 155} {
+			clip := image.NewRGBA(image.Rect(0, 0, 120, full.Rect.Dy()))
+			if !drawSystemText(clip, text, font, 16, scale, style, ink, offset) {
+				t.Fatal("clipped texture failed")
+			}
+			for y := 0; y < clip.Rect.Dy(); y++ {
+				i := full.PixOffset(offset, y)
+				j := clip.PixOffset(0, y)
+				if !bytes.Equal(full.Pix[i:i+clip.Stride], clip.Pix[j:j+clip.Stride]) {
+					t.Fatalf("scale %v offset %d row %d: clipped pixels differ from full texture", scale, offset, y)
+				}
+			}
+		}
+	}
+}
+
+func TestCoreTextBitmapIsUpright(t *testing.T) {
+	img := image.NewRGBA(image.Rect(0, 0, 80, 80))
+	if !drawSystemText(img, "L", "Menlo-Regular", 28, 2, fyne.TextStyle{}, color.NRGBA{A: 255}, 0) {
+		t.Fatal("drawing failed")
+	}
+	rows := make([]int, img.Rect.Dy())
+	for y := range rows {
+		for x := 0; x < img.Rect.Dx(); x++ {
+			if img.RGBAAt(x, y).A > 100 {
+				rows[y]++
+			}
+		}
+	}
+	first, last := 0, len(rows)-1
+	for first < last && rows[first] == 0 {
+		first++
+	}
+	for last > first && rows[last] == 0 {
+		last--
+	}
+	if rows[last]+rows[last-1] <= rows[first]+rows[first+1] {
+		t.Fatalf("L's bottom stroke is inverted or missing: first=%d last=%d rows=%v", first, last, rows)
+	}
+}
+
+func TestCoreTextTabsAndMonospaceGrid(t *testing.T) {
+	for _, style := range []fyne.TextStyle{{}, {TabWidth: 8}, {Monospace: true}, {Monospace: true, TabWidth: 2}} {
+		font := nativeOnlyFont("Menlo-Regular")
+		plain, _ := measureText("MMMMMMMMMM", 14, style, font)
+		single, _ := measureText("M", 14, style, font)
+		if math.Abs(float64(plain.Width-single.Width*10)) > 0.001 {
+			t.Fatal("monospace grid drifts from the rendered advance")
+		}
+		tabWidth := style.TabWidth
+		if tabWidth <= 0 {
+			tabWidth = 4
+		}
+		space, _ := measureText(" ", 14, style, font)
+		stop := float32(10 * tabWidth)
+		if style.Monospace {
+			stop = space.Width * float32(tabWidth)
+		}
+		got, _ := measureText("M\tM", 14, style, font)
+		want := (float32(math.Floor(float64(single.Width/stop)))+1)*stop + single.Width
+		if math.Abs(float64(got.Width-want)) > 0.001 {
+			t.Fatalf("tab advance = %v, want %v", got.Width, want)
+		}
+	}
+	if singleLineText("a\r\nb\xff") != "a�b�" {
+		t.Fatal("line breaks or invalid UTF-8 escaped normalization")
+	}
+}
+
+func TestCoreTextTruncatesOnGraphemeBoundariesWithoutGoFonts(t *testing.T) {
+	for _, cluster := range []string{"🇺🇸", "👩‍💻", "e\u0301", "中"} {
+		obj := &canvas.Text{TextSize: 16, FontSource: nativeOnlyFont("PingFangSC-Regular")}
+		prefix := "Loop " + cluster
+		size, _ := measureText(prefix+"…", 16, fyne.TextStyle{}, obj.FontSource)
+		text := prefix + " second node with a very long name"
+		count, full, ok := SystemTextTruncate(text, obj, size.Width+0.01, "…")
+		if !ok || full || count != utf8.RuneCountInString(prefix) {
+			t.Fatalf("%q: truncated at %d, full=%v ok=%v", cluster, count, full, ok)
+		}
+		count, full, ok = SystemTextTruncate(text, obj, 1000, "…")
+		if !ok || !full || count != utf8.RuneCountInString(text) {
+			t.Fatal("fitting label was truncated")
+		}
+	}
+}
+
+func TestCoreTextConcurrentFontCacheEviction(t *testing.T) {
+	var wg sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 64; i++ {
+				size := float32(10 + i)
+				style := fyne.TextStyle{Italic: i%2 == 0}
+				if _, _, ok := measureSystemText("中文🚀Ag", "PingFangSC-Regular", size, style); !ok {
+					t.Error("concurrent measurement failed")
+				}
+				img := image.NewRGBA(image.Rect(0, 0, 300, 100))
+				if !drawSystemText(img, "中文🚀Ag", "PingFangSC-Regular", size, 1, style, color.NRGBA{A: 255}, 0) {
+					t.Error("concurrent drawing failed")
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
