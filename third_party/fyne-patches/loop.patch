@@ -0,0 +1,39 @@
+package painter_test
+
+import (
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/container"
+	"fyne.io/fyne/v2/internal/painter"
+	"fyne.io/fyne/v2/test"
+	"fyne.io/fyne/v2/theme"
+	"fyne.io/fyne/v2/widget"
+	"testing"
+)
+
+type overrideFontTheme struct {
+	fyne.Theme
+	font fyne.Resource
+}
+
+func (t overrideFontTheme) Font(fyne.TextStyle) fyne.Resource { return t.font }
+
+func TestColorThemeScopesShareFacesButDifferentFontsDoNot(t *testing.T) {
+	a := test.NewApp()
+	defer a.Quit()
+	painter.ClearFontCache()
+	font := theme.DefaultTextFont()
+	th := overrideFontTheme{Theme: theme.DefaultTheme(), font: font}
+	one, two := widget.NewLabel("one"), widget.NewLabel("two")
+	container.NewThemeOverride(one, th)
+	container.NewThemeOverride(two, th)
+	first := painter.CachedFontFace(fyne.TextStyle{}, nil, one)
+	second := painter.CachedFontFace(fyne.TextStyle{Underline: true, TabWidth: 8}, nil, two)
+	if first != second {
+		t.Fatal("color/theme scopes or text decorations duplicated glyph caches")
+	}
+	other := widget.NewLabel("other")
+	container.NewThemeOverride(other, overrideFontTheme{Theme: th.Theme, font: theme.DefaultTextBoldFont()})
+	if painter.CachedFontFace(fyne.TextStyle{}, nil, other) == first {
+		t.Fatal("different theme fonts shared one font map")
+	}
+}
diff --git a/internal/painter/font_tables.go b/internal/painter/font_tables.go
new file mode 100644
index 0000000..5337748
--- /dev/null
+++ b/internal/painter/font_tables.go
@@ -0,0 +1,136 @@
+package painter
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+
+	"fyne.io/fyne/v2"
+	"github.com/go-text/typesetting/font"
+	"github.com/go-text/typesetting/font/opentype"
+	"github.com/go-text/typesetting/font/opentype/tables"
+)
+
+// Color/theme changes invalidate Fyne's style caches, but not font files.
+// Keep a bounded cache of immutable parsed tables across styles and themes.
+// Content keys also handle resources whose bytes change without changing name.
+const parsedFontCacheLimit = 16
+
+var measureFontCache parsedFontStore
+
+type parsedFontStore struct {
+	sync.Mutex
+	fonts map[[sha256.Size]byte]*font.Font
+	order [][sha256.Size]byte // least recently used first
+}
+
+// Read only the small character map for pending fallbacks. In particular, do
+// not call Content on a file resource and recreate its full SFNT copy merely
+// to decide whether it has a Chinese/emoji glyph.
+func fontCoverage(source fyne.Resource) (font.Cmap, error) {
+	var loader *opentype.Loader
+	if backed, ok := source.(fyne.FontFileResource); ok {
+		path, index := backed.FontFile()
+		file, err := os.Open(path)
+		if err != nil {
+			return nil, err
+		}
+		defer file.Close()
+		loaders, err := opentype.NewLoaders(file)
+		if err != nil {
+			return nil, err
+		}
+		if index < 0 || index >= len(loaders) {
+			return nil, fmt.Errorf("invalid font collection index %d", index)
+		}
+		loader = loaders[index]
+	} else {
+		var err error
+		loader, err = opentype.NewLoader(bytes.NewReader(source.Content()))
+		if err != nil {
+			return nil, err
+		}
+	}
+	raw, _ := loader.RawTable(opentype.MustNewTag("OS/2"))
+	os2, _, _ := tables.ParseOs2(raw)
+	raw, err := loader.RawTable(opentype.MustNewTag("cmap"))
+	if err != nil {
+		return nil, err
+	}
+	cmap, _, err := tables.ParseCmap(raw)
+	if err != nil {
+		return nil, err
+	}
+	parsed, _, err := font.ProcessCmap(cmap, os2.FontPage())
+	return parsed, err
+}
+
+func (c *parsedFontStore) load(data []byte) (*font.Font, error) {
+	key := sha256.Sum256(data)
+	return c.loadKey(key, func() (*font.Font, error) {
+		loader, err := opentype.NewLoader(bytes.NewReader(data))
+		if err != nil {
+			return nil, err
+		}
+		return font.NewFont(loader)
+	})
+}
+
+func (c *parsedFontStore) loadFile(path string, index int) (*font.Font, error) {
+	path, err := filepath.Abs(path)
+	if err != nil {
+		return nil, err
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	key := sha256.Sum256([]byte(fmt.Sprintf("file:%s:%d:%d:%d", path, index, info.Size(), info.ModTime().UnixNano())))
+	return c.loadKey(key, func() (*font.Font, error) {
+		loaders, err := opentype.NewLoaders(file)
+		if err != nil {
+			return nil, err
+		}
+		if index < 0 || index >= len(loaders) {
+			return nil, fmt.Errorf("invalid font collection index %d", index)
+		}
+		return font.NewFont(loaders[index])
+	})
+}
+
+func (c *parsedFontStore) loadKey(key [sha256.Size]byte, parse func() (*font.Font, error)) (*font.Font, error) {
+	c.Lock()
+	defer c.Unlock()
+	if parsed := c.fonts[key]; parsed != nil {
+		for i, existing := range c.order {
+			if existing == key {
+				copy(c.order[i:], c.order[i+1:])
+				c.order[len(c.order)-1] = key
+				break
+			}
+		}
+		return parsed, nil
+	}
+	parsed, err := parse()
+	if err != nil {
+		return nil, err
+	}
+	if c.fonts == nil {
+		c.fonts = make(map[[sha256.Size]byte]*font.Font)
+	}
+	if len(c.order) == parsedFontCacheLimit {
+		delete(c.fonts, c.order[0])
+		c.order = c.order[1:]
+	}
+	c.fonts[key] = parsed
+	c.order = append(c.order, key)
+	return parsed, nil
+}
