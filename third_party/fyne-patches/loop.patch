+package painter
+
+import (
+	"crypto/sha256"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/theme"
+	"github.com/go-text/typesetting/font"
+)
+
+func TestFontTablesSharedAcrossResourcesAndThemeChanges(t *testing.T) {
+	data := theme.DefaultTextFont().Content()
+	a := loadMeasureFont(fyne.NewStaticResource("one.ttf", data))
+	b := loadMeasureFont(fyne.NewStaticResource("two.ttf", append([]byte(nil), data...)))
+	if a == nil || b == nil || a == b || a.Font != b.Font {
+		t.Fatal("fonts must share immutable tables, with separate mutable faces")
+	}
+	a.SetPpem(12, 12)
+	if x, _ := b.Ppem(); x != 0 {
+		t.Fatal("face settings leaked to another consumer")
+	}
+	ClearFontCache()
+	c := loadMeasureFont(fyne.NewStaticResource("one.ttf", data))
+	if c.Font != a.Font {
+		t.Fatal("a color/theme change reparsed unchanged font tables")
+	}
+	changed := loadMeasureFont(fyne.NewStaticResource("one.ttf", theme.DefaultTextBoldFont().Content()))
+	if changed.Font == a.Font {
+		t.Fatal("resource names must not alias different font contents")
+	}
+}
+
+type fileOnlyFont struct{ path string }
+
+func (f fileOnlyFont) Name() string            { return "file-only.ttf" }
+func (f fileOnlyFont) FontFile() (string, int) { return f.path, 0 }
+func (f fileOnlyFont) Content() []byte         { panic("font painter must not materialize Content") }
+
+func TestFileFontReadsTablesWithoutKeepingContentOrFileOpen(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "font.ttf")
+	if err := os.WriteFile(path, theme.DefaultTextFont().Content(), 0600); err != nil {
+		t.Fatal(err)
+	}
+	source := fileOnlyFont{path: path}
+	coverage, err := fontCoverage(source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := coverage.Lookup('A'); !ok {
+		t.Fatal("file-backed fallback lost its character map")
+	}
+	a := loadMeasureFont(source)
+	b := loadMeasureFont(source)
+	if a == nil || b == nil || a == b || a.Font != b.Font {
+		t.Fatal("file-backed fonts must share tables with independent faces")
+	}
+	// Fully parsed tables must remain usable after the source has been closed
+	// and removed. No glyph lookup should attempt another file read.
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	glyph, ok := a.NominalGlyph('A')
+	if _, outlineOK := a.GlyphDataOutline(glyph); !ok || !outlineOK {
+		t.Fatal("parsed font still depended on the source file")
+	}
+	var cache parsedFontStore
+	if _, err := cache.loadFile(path, 0); err == nil {
+		t.Fatal("missing file was accepted")
+	}
+	if err := os.WriteFile(path, theme.DefaultTextFont().Content(), 0600); err != nil {
+		t.Fatal(err)
+	}
+	first, _ := cache.loadFile(path, 0)
+	if _, err := cache.loadFile(path, 1); err == nil {
+		t.Fatal("invalid collection index was accepted")
+	}
+	if err := os.WriteFile(path, theme.DefaultTextBoldFont().Content(), 0600); err != nil {
+		t.Fatal(err)
+	}
+	second, err := cache.loadFile(path, 0)
+	if err != nil || second == first {
+		t.Fatal("file replacement reused stale font tables", err)
+	}
+}
+
+func TestFallbacksStayLazyUntilTheirGlyphIsNeeded(t *testing.T) {
+	base, fallback := theme.DefaultTextFont(), theme.DefaultSymbolFont()
+	faces := lookupFaces(base, base, []fyne.Resource{fallback}, "sans-serif", fyne.TextStyle{})
+	if len(faces.pending) != 1 || faces.faces[1] != nil {
+		t.Fatal("fallback was parsed before use")
+	}
+	faces.ResolveFace('A')
+	if faces.faces[1] != nil {
+		t.Fatal("ASCII text loaded the symbol fallback")
+	}
+	resolved := faces.ResolveFace('⌘')
+	if faces.faces[1] == nil || resolved != faces.faces[1] || len(faces.pending) != 0 {
+		t.Fatal("a missing symbol did not load its fallback in order")
+	}
+}
+
+func TestFontTableCacheConcurrentAndBounded(t *testing.T) {
+	var cache parsedFontStore
+	data := theme.DefaultTextFont().Content()
+	var group sync.WaitGroup
+	parsed := make([]*font.Font, 8)
+	for i := range parsed {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			var err error
+			parsed[i], err = cache.load(data)
+			if err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	group.Wait()
+	for _, face := range parsed {
+		if face != parsed[0] {
+			t.Fatal("concurrent loads parsed the same data more than once")
+		}
+	}
+	// Extra padding changes the content key without changing font tables.
+	for i := 0; i < parsedFontCacheLimit; i++ {
+		variant := append(append([]byte(nil), data...), byte(i))
+		if _, err := cache.load(variant); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(cache.fonts) != parsedFontCacheLimit || cache.fonts[sha256.Sum256(data)] != nil {
+		t.Fatal("unused fonts were not evicted from the bounded cache")
+	}
+	if _, err := cache.load([]byte("invalid")); err == nil || len(cache.fonts) != parsedFontCacheLimit {
+		t.Fatal("an invalid font polluted the cache")
+	}
+}
