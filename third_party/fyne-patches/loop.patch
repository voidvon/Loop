+package svg
+
+import (
+	"bytes"
+	"image/color"
+	"testing"
+)
+
+func TestLoopOutlineGroupKeepsHollowShapeAndThemeStroke(t *testing.T) {
+	source := []byte(`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="#000" stroke-width="2"><circle fill="none" cx="12" cy="12" r="8"/></g></svg>`)
+	data, err := Colorize(source, color.NRGBA{R: 12, G: 34, B: 56, A: 128})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(data, []byte(`stroke="#0c2238"`)) || !bytes.Contains(data, []byte(`stroke-opacity="0.501961"`)) {
+		t.Fatalf("outline stroke did not receive theme color and opacity: %s", data)
+	}
+	d, err := NewDecoder(bytes.NewReader(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+	img, err := d.Draw(24, 24)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if img.NRGBAAt(12, 12).A != 0 {
+		t.Fatal("the hollow icon became a filled shape")
+	}
+	if img.NRGBAAt(12, 4).A == 0 {
+		t.Fatal("the themed outline disappeared")
+	}
+}
