--- /dev/null
+++ b/internal/painter/text_coretext_darwin.go
@@ -0,0 +1,56 @@
+//go:build darwin && cgo && !ios
+
+package painter
+
+/*
+#cgo LDFLAGS: -framework Foundation -framework CoreText -framework CoreGraphics
+#include <stdlib.h>
+#include "text_coretext_darwin.h"
+*/
+import "C"
+
+import (
+	"image"
+	"image/color"
+	"math"
+	"unsafe"
+
+	"fyne.io/fyne/v2"
+)
+
+func nativeFlag(value bool) C.int {
+	if value {
+		return 1
+	}
+	return 0
+}
+
+func measureSystemText(text, name string, size float32, style fyne.TextStyle) (fyne.Size, float32, bool) {
+	if size <= 0 || math.IsNaN(float64(size)) || math.IsInf(float64(size), 0) {
+		return fyne.Size{}, 0, false
+	}
+	input, fontName := C.CString(text), C.CString(name)
+	defer C.free(unsafe.Pointer(input))
+	defer C.free(unsafe.Pointer(fontName))
+	metrics := C.loopTextMeasure(input, C.size_t(len(text)), fontName, C.double(size), nativeFlag(style.Italic), nativeFlag(style.Monospace), C.int(style.TabWidth))
+	return fyne.NewSize(float32(metrics.width), float32(metrics.height)), float32(metrics.baseline), metrics.ok != 0
+}
+
+func drawSystemText(dst *image.RGBA, text, name string, size, scale float32, style fyne.TextStyle, ink color.NRGBA, offset int) bool {
+	if size <= 0 || scale <= 0 || math.IsNaN(float64(size+scale)) || math.IsInf(float64(size+scale), 0) {
+		return false
+	}
+	if dst.Rect.Empty() {
+		return true
+	}
+	if dst.Stride < dst.Rect.Dx()*4 || len(dst.Pix)/dst.Stride < dst.Rect.Dy() {
+		return false
+	}
+	input, fontName := C.CString(text), C.CString(name)
+	defer C.free(unsafe.Pointer(input))
+	defer C.free(unsafe.Pointer(fontName))
+	// The synchronous C call only borrows the RGBA byte buffer. CoreGraphics
+	// releases the context before returning and never keeps a Go pointer.
+	ok := C.loopTextDraw((*C.uint8_t)(unsafe.Pointer(&dst.Pix[0])), C.int(dst.Rect.Dx()), C.int(dst.Rect.Dy()), C.int(dst.Stride), input, C.size_t(len(text)), fontName, C.double(size), nativeFlag(style.Italic), nativeFlag(style.Monospace), C.int(style.TabWidth), C.double(scale), C.int(offset), C.double(ink.R)/255, C.double(ink.G)/255, C.double(ink.B)/255, C.double(ink.A)/255)
+	return ok != 0
+}
