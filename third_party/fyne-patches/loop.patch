diff --git a/internal/driver/glfw/loop_transparency_darwin_test.go b/internal/driver/glfw/loop_transparency_darwin_test.go
new file mode 100644
index 0000000..2dab35a
--- /dev/null
+++ b/internal/driver/glfw/loop_transparency_darwin_test.go
@@ -0,0 +1,50 @@
+//go:build darwin && !no_glfw && !mobile
+
+package glfw
+
+import (
+	"image/color"
+	"testing"
+
+	"fyne.io/fyne/v2"
+	"fyne.io/fyne/v2/canvas"
+	"github.com/go-gl/gl/v2.1/gl"
+	"github.com/go-gl/glfw/v3.4/glfw"
+	"github.com/stretchr/testify/assert"
+)
+
+// Exercise real NSGL framebuffer alpha, including the GLFW creation hint and
+// the painter's blend function. Software canvas captures cannot catch this.
+func TestLoopTransparentFramebuffer(t *testing.T) {
+	var transparent, opaque *safeWindow
+	runOnMain(func() {
+		w := d.CreateWindow("transparent framebuffer").(*window)
+		w.canvas.SetTransparent(true)
+		w.SetPadded(false)
+		w.SetContent(canvas.NewRectangle(color.NRGBA{R: 255, A: 128}))
+		w.Resize(fyne.NewSize(100, 100))
+		w.create()
+		transparent = &safeWindow{window: w}
+		w.Show()
+	})
+	defer transparent.Close()
+	repaintWindow(transparent)
+	runOnMain(func() {
+		assert.Equal(t, glfw.True, transparent.viewport.GetAttrib(glfw.TransparentFramebuffer))
+		transparent.RunWithContext(func() {
+			width, height := transparent.viewport.GetFramebufferSize()
+			var pixel [4]uint8
+			gl.ReadBuffer(gl.FRONT)
+			gl.ReadPixels(int32(width/2), int32(height/2), 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, gl.Ptr(&pixel[0]))
+			gl.ReadBuffer(gl.BACK)
+			assert.InDelta(t, 128, pixel[0], 1, "surface RGB should be premultiplied once")
+			assert.InDelta(t, 128, pixel[3], 1, "surface alpha must not be squared")
+		})
+		w := d.CreateWindow("opaque framebuffer").(*window)
+		w.SetContent(canvas.NewRectangle(color.White))
+		w.create()
+		opaque = &safeWindow{window: w}
+		assert.Equal(t, glfw.False, w.viewport.GetAttrib(glfw.TransparentFramebuffer), "transparent hint leaked into the next window")
+	})
+	defer opaque.Close()
+}
